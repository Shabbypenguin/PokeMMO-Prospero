#!/usr/bin/env bash
# Build the toolchain image or run a command inside it with the repo mounted at /work.
#
#   scripts/ps5env build            build (or rebuild) the image
#   scripts/ps5env shell            interactive shell in the container
#   scripts/ps5env <command...>     run one command, e.g. scripts/ps5env make probe
#
# Docker needs root on the build host; set DOCKER="docker" if your user is in the docker group.
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
image=${PS5ENV_IMAGE:-pokemmo-ps5-toolchain:latest}
docker_cmd=${DOCKER:-sudo docker}
# Extra flags for docker build/run (e.g. --network host behind a proxy).
read -r -a extra <<<"${PS5ENV_DOCKER_FLAGS:-}"

case "${1:-shell}" in
    build)
        exec $docker_cmd build "${extra[@]}" -t "$image" -f "$root/docker/Dockerfile" "$root"
        ;;
    shell)
        exec $docker_cmd run --rm -it "${extra[@]}" -v "$root:/work" "$image" bash
        ;;
    *)
        tty_flag=()
        [[ -t 0 && -t 1 ]] && tty_flag=(-it)
        exec $docker_cmd run --rm "${tty_flag[@]}" "${extra[@]}" \
            --user "$(id -u):$(id -g)" -e HOME=/work/.home \
            -v "$root:/work" "$image" "$@"
        ;;
esac
